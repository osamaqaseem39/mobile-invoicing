generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model NumberCounter {
  key   String @id
  value Int    @default(0)
}

model Grade {
  id        String @id @default(cuid())
  code      String @unique
  label     String
  sortOrder Int
}

model Color {
  id   String @id @default(cuid())
  name String @unique
}

model Network {
  id   String @id @default(cuid())
  name String @unique
}

model Supplier {
  id             String           @id @default(cuid())
  name           String
  phone          String?
  email          String?
  address        String?
  vatNumber      String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  purchaseOrders PurchaseOrder[]
  ledger         SupplierLedger[]
  stockUnits     StockUnit[]
}

model SupplierLedger {
  id              String         @id @default(cuid())
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type            String
  amountGbp       Float
  date            DateTime       @default(now())
  reference       String?
  notes           String?
  purchaseOrderId String?
  createdAt       DateTime       @default(now())
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  poNumber        String              @unique
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  status          String              @default("DRAFT")
  notes           String?
  shippingCostGbp Float               @default(0)
  actualCostGbp   Float               @default(0)
  orderedAt          DateTime?
  receivedAt         DateTime?
  attachmentFilename String?
  attachmentMimeType String?
  attachmentData     Bytes?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lines              PurchaseOrderLine[]
  stockUnits         StockUnit[]
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productName     String
  color           String?
  network         String?
  grade           String?
  qty             Int
  unitCostGbp     Float
}

model StockUnit {
  id              String          @id @default(cuid())
  imei            String?         @unique
  productName     String
  brand           String?
  color           String
  network         String
  grade           String
  costGbp         Float
  status          String          @default("IN_STOCK")
  supplierId      String?
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  invoiceId       String?
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id])
  invoiceLineId   String?
  invoiceLine     InvoiceLine?    @relation(fields: [invoiceLineId], references: [id])
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  rmaItems        RmaItem[]
}

model Customer {
  id              String    @id @default(cuid())
  clientId        String    @unique
  name            String
  businessName    String?
  phone           String?
  email           String?
  vatNumber       String?
  address         String?
  shippingAddress String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoices        Invoice[]
  rmas            Rma[]
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  status          String        @default("PENDING")
  shippingCostGbp Float         @default(0)
  shippingLabel   String?
  paymentTerms    String?       @default("Immediate")
  warrantyTerms   String?       @default("3 months")
  marginVatScheme Boolean       @default(true)
  paidAmountGbp   Float         @default(0)
  notes           String?
  issuedAt        DateTime      @default(now())
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lines           InvoiceLine[]
  stockUnits      StockUnit[]
  rmas            Rma[]
  shipments       Shipment[]
  appliedCredits  Rma[]         @relation("RmaAppliedInvoice")
  payments        Payment[]
  installments    Installment[]
}

model InvoiceLine {
  id           String      @id @default(cuid())
  invoiceId    String
  invoice      Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  qty          Int
  productName  String
  color        String
  network      String
  grade        String
  unitPriceGbp Float
  buyPriceGbp  Float       @default(0)
  imeis        String[]    @default([])
  sortOrder    Int         @default(0)
  stockUnits   StockUnit[]
}

model Rma {
  id               String    @id @default(cuid())
  rmaNumber        String    @unique
  invoiceId        String
  invoice          Invoice   @relation(fields: [invoiceId], references: [id])
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  status           String    @default("OPEN")
  reason           String?
  notes            String?
  paymentType      String    @default("PENDING")
  paymentDate      DateTime?
  paymentAmountGbp Float     @default(0)
  appliedInvoiceId String?
  appliedInvoice   Invoice?  @relation("RmaAppliedInvoice", fields: [appliedInvoiceId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  items            RmaItem[]
  payments         Payment[]
}

model RmaItem {
  id            String     @id @default(cuid())
  rmaId         String
  rma           Rma        @relation(fields: [rmaId], references: [id], onDelete: Cascade)
  stockUnitId   String?
  stockUnit     StockUnit? @relation(fields: [stockUnitId], references: [id])
  invoiceNumber String?
  productName   String?
  imei          String?
  color         String?
  grade         String?
  action        String     @default("RESTOCK")
  unitPriceGbp  Float      @default(0)
  reason        String?
}

model Payment {
  id            String       @id @default(cuid())
  invoiceId     String
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installmentId String?      @unique
  installment   Installment? @relation(fields: [installmentId], references: [id])
  rmaId         String?
  rma           Rma?         @relation(fields: [rmaId], references: [id])
  amountGbp     Float
  method        String?
  notes         String?
  paidAt        DateTime     @default(now())
  createdAt     DateTime     @default(now())
}

model Installment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  dueDate   DateTime
  amountGbp Float
  status    String   @default("PENDING")
  payment   Payment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id              String   @id @default(cuid())
  shipmentNumber  String   @unique
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  trackingNumber  String?
  carrier         String?
  shippingCostGbp Float    @default(0)
  actualCostGbp   Float    @default(0)
  status          String   @default("PREPARING")
  notes           String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
