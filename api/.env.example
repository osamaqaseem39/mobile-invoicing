# Supabase → Project Settings → Database
# DATABASE_URL = Transaction pooler (port 6543)
# DIRECT_URL   = Direct connection or Session pooler (port 5432)
#
# On Hostinger shared Node hosting, keep the pool tiny or Prisma's Rust
# engine can panic with "PANIC: timer has gone away" (process/thread limits).
# The API also appends connection_limit=1&pool_timeout=10 when missing.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=10"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:5432/postgres"

PORT=3000

# Separate secret from the dashboard's AUTH_SECRET so the two token systems can be
# rotated independently. Generate with: openssl rand -base64 32
API_JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated allow-list of browser origins allowed to call this API with
# credentials (CORS). Native apps and server-to-server calls send no Origin header
# and are always allowed through. Any https://*.vercel.app preview origin is also
# auto-allowed. Includes the dashboard's own dev origin (port 5173) by default.
CORS_ORIGIN="https://dashboard.atlanticdevicessolutions.co.uk,https://api.atlanticdevicessolutions.co.uk,http://localhost:5173,http://localhost:8081,http://localhost:19006"

# SMTP settings used to email invoices to customers (POST /invoices/:id/send-email).
# Hostinger mailbox (IMAP/SMTP). Port 465 uses implicit TLS (SMTP_SECURE=true).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="info@atlanticdevicessolutions.co.uk"
SMTP_PASS="replace-with-mailbox-password"
MAIL_FROM="Atlantic Devices Solutions <info@atlanticdevicessolutions.co.uk>"
